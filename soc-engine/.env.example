# Copy this file to .env and fill in real values. Never commit the real .env.

SOC_DB_HOST=localhost
SOC_DB_PORT=5432
SOC_DB_NAME=socdb
SOC_DB_USER=postgres
SOC_DB_PASSWORD=changeme

WAZUH_ALERTS_JSON_PATH=/var/ossec/logs/alerts/alerts.json

# True-positive model: Logistic Regression trained with soc-dataset/models/train_logreg_deploy.py
# (or train_logreg_v3_with_live_labels.py). The severity model comes from the training notebook.
TP_MODEL_PATH=../soc-dataset/models/wazuh_tp_logreg.joblib
SEV_MODEL_PATH=../soc-dataset/models/wazuh_severity_classifier.joblib
MODEL_VERSION=tp_logreg_v2+sev_v1

# Recall-guaranteed calibration (see calibration.py and the paper)
DEFAULT_THRESHOLD=0.5      # used until enough attacks are labelled (no guarantee)
CALIB_RHO=0.90             # target attack recall
CALIB_DELTA=0.10           # allowed failure probability
# Secret required to save analyst labels on the dashboard. Leave EMPTY to disable label writes.
# Generate one with:  openssl rand -hex 12
LABEL_TOKEN=

# Optional phone-call alerting (project feature, not part of the paper's results).
# Twilio: verify your own phone number as the "to" number so trial calls are allowed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
